<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志：控制台 + 滚动文件；pattern 含 MDC traceId（见 TraceIdFilter）
  LOG_PATH 可覆盖日志目录，默认 logs/
-->
<configuration>
    <!-- 统一输出格式：时间 线程 级别 logger [traceId] 消息 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId}] - %msg%n"/>
    <property name="LOG_HOME" value="${LOG_PATH:-logs}"/>

    <!-- 控制台（IDE / 容器 stdout） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 按天+大小滚动，gzip 归档，保留约 14 天，总量上限 1GB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/smart-cane.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/smart-cane.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 开发：INFO + 业务 DEBUG -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.ruoyi" level="DEBUG"/>
    </springProfile>

    <!-- 生产：WARN + 业务 INFO -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.ruoyi" level="INFO"/>
    </springProfile>

    <!-- 其它 profile：默认 INFO -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
