# Spring Boot 环境变量示例
# 复制后按需填写；生产启动示例：
#   export SPRING_PROFILES_ACTIVE=prod
#   java -jar Excellent-1.0-SNAPSHOT.jar

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

DB_URL=jdbc:mysql://localhost:3306/smart_cane?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai
DB_USERNAME=smart_cane
DB_PASSWORD=请填写并轮换后的数据库密码

AUTH_ENABLED=true
ALLOW_TEST_SMS=false
CORS_ORIGINS=https://intelligent.shinegoldyao.store
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改管理端密码
JWT_SECRET=请换成至少32位的随机字符串
DEVICE_API_KEY=请填写硬件上报密钥

AMAP_WEB_KEY=
DEEPSEEK_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

DEMO_LOCATION_FORCE=false

# Redis（可选；默认关闭。多实例建议开启，用于限流与看板缓存）
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 定时清理（可选）
PRUNE_ENABLED=true
PRUNE_SENSOR_KEEP=50
PRUNE_ALARM_KEEP=20

# 注意：若密钥曾提交或泄露，请在云控制台轮换 AMAP / DeepSeek / 百度密钥，并更新本机 application-local.yml
