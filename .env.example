# ==================== 通用配置 ====================
APP_NAME=智能盲杖系统
APP_ENV=development
APP_PORT=8081

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_cane
DB_USERNAME=root
DB_PASSWORD=123456
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==================== JWT配置 ====================
JWT_SECRET=smart-cane-secret-key-2024
JWT_EXPIRATION=86400000

# ==================== 小程序配置 ====================
MINI_APP_ID=your_mini_app_id
MINI_APP_SECRET=your_mini_app_secret

# ==================== 高德地图配置 ====================
AMAP_KEY=your_amap_key
AMAP_SECRET=your_amap_secret

# ==================== 文件上传配置 ====================
UPLOAD_PATH=/data/uploads
MAX_FILE_SIZE=10485760

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_PATH=/data/logs

# ==================== WebSocket配置 ====================
WS_ENABLED=true
WS_PATH=/ws

# ==================== 前端配置 ====================
FRONTEND_PORT=3000
FRONTEND_API_URL=http://localhost:8081/api

# ==================== 小程序端配置 ====================
MINIAPP_API_URL=http://localhost:8081/api
