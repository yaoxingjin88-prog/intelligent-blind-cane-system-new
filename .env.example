# ==================== 通用 ====================
APP_NAME=智能盲杖系统
APP_ENV=development
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# ==================== 数据库 ====================
DB_URL=jdbc:mysql://localhost:3306/smart_cane?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=smart_cane
DB_PASSWORD=

# ==================== 安全（生产务必覆盖） ====================
AUTH_ENABLED=true
ALLOW_TEST_SMS=true
ADMIN_USERNAME=admin
# 明文或 BCrypt（$2a$...）
ADMIN_PASSWORD=123456
JWT_SECRET=local-dev-jwt-secret-key-please-rotate-32
# 硬件 POST /api/sensor-data 请求头 X-Device-Key；空=本地不校验
DEVICE_API_KEY=

# ==================== Redis（规划中，当前后端未接入） ====================
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ==================== 第三方 ====================
AMAP_WEB_KEY=
DEEPSEEK_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ==================== 日志目录（logback LOG_PATH） ====================
LOG_PATH=logs

# ==================== 前端 / 小程序 ====================
FRONTEND_PORT=3000
VITE_API_BASE_URL=
